{
  "name": "hipaa-fhir-mcp",
  "version": "0.4.0",
  "description": "HIPAA-oriented MCP server exposing FHIR R4 tools to AI agents",
  "license": "MIT",
  "author": "Tanya Babitskaya",
  "homepage": "https://github.com/tanya-ok/hipaa-fhir-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanya-ok/hipaa-fhir-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tanya-ok/hipaa-fhir-mcp/issues"
  },
  "keywords": [
    "mcp",
    "fhir",
    "hipaa",
    "healthcare",
    "audit"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "hipaa-fhir-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level moderate",
    "check:phi": "node scripts/check-phi.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "package:mcpb": "node scripts/package-mcpb.mjs",
    "check:mcpb": "python3 scripts/test-mcpb.py"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
